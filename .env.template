APPLE_DEVELOPER_ID_CERTIFICATE_BASE64='optional, base64 .p12 Developer ID Application certificate for Mac apps outside the App Store; group of APPLE_DEVELOPER_ID_CERTIFICATE_*'
APPLE_DEVELOPER_ID_CERTIFICATE_PASSWORD='optional, password of the APPLE_DEVELOPER_ID_CERTIFICATE_BASE64 .p12; group of APPLE_DEVELOPER_ID_CERTIFICATE_*'
APPLE_DEVELOPMENT_CERTIFICATE_BASE64='optional, base64 .p12 Apple Development certificate for app builds; group of APPLE_DEVELOPMENT_CERTIFICATE_*'
APPLE_DEVELOPMENT_CERTIFICATE_PASSWORD='optional, password of the APPLE_DEVELOPMENT_CERTIFICATE_BASE64 .p12; group of APPLE_DEVELOPMENT_CERTIFICATE_*'
APPLE_DISTRIBUTION_CERTIFICATE_BASE64='optional, base64 .p12 Apple Distribution certificate for App Store uploads; group of APPLE_DISTRIBUTION_CERTIFICATE_*'
APPLE_DISTRIBUTION_CERTIFICATE_PASSWORD='optional, password of the APPLE_DISTRIBUTION_CERTIFICATE_BASE64 .p12; group of APPLE_DISTRIBUTION_CERTIFICATE_*'
APPLE_ISSUER_ID='optional, App Store Connect API issuer ID, a UUID; group of APPLE_ISSUER_ID, APPLE_KEY_ID, and APPLE_KEY_SECRET_BASE64, required to publish apps'
APPLE_KEY_ID='optional, App Store Connect API key ID, 10 characters; group of APPLE_ISSUER_ID, APPLE_KEY_ID, and APPLE_KEY_SECRET_BASE64'
APPLE_KEY_SECRET_BASE64='optional, base64 App Store Connect API .p8 private key; group of APPLE_ISSUER_ID, APPLE_KEY_ID, and APPLE_KEY_SECRET_BASE64'
APPLE_MAC_INSTALLER_DISTRIBUTION_CERTIFICATE_BASE64='optional, base64 .p12 Mac Installer Distribution certificate for Mac App Store uploads; group of APPLE_MAC_INSTALLER_DISTRIBUTION_CERTIFICATE_*'
APPLE_MAC_INSTALLER_DISTRIBUTION_CERTIFICATE_PASSWORD='optional, password of the APPLE_MAC_INSTALLER_DISTRIBUTION_CERTIFICATE_BASE64 .p12, may be empty; group of APPLE_MAC_INSTALLER_DISTRIBUTION_CERTIFICATE_*'
APPLE_TEAM_ID='optional, Apple Developer team ID, 10 characters; required to build or publish apps'
BACKUP_ACCESS_KEY_ID='optional, S3 access key ID for database backups; group of BACKUP_*, required on deployed backends'
BACKUP_BUCKET='optional, S3 bucket for database backups; group of BACKUP_*'
BACKUP_ENDPOINT='optional, S3 endpoint URL for database backups, such as https://s3.example.com; group of BACKUP_*'
BACKUP_SECRET_ACCESS_KEY='optional, S3 secret access key for database backups; group of BACKUP_*'
CLOUDFLARE_TOKEN='optional, Cloudflare API token with Zone DNS Edit, Workers Scripts Edit, and Workers Routes Edit; required to deploy'
CRYPT_KEY='required, random 128-character hex string for encrypting stored data'
DASHBOARD_PASSWORD='optional, GoodJob dashboard password; group of DASHBOARD_*, the built-in default applies when empty'
DASHBOARD_USERNAME='optional, GoodJob dashboard username; group of DASHBOARD_*, the built-in default applies when empty'
DEPLOY_PASSWORD='optional, sudo password of the deploy user on the droplet; group of DEPLOY_*, required to deploy a droplet'
DEPLOY_SSH_KEY='optional, multiline PEM RSA private key of the deploy user; group of DEPLOY_*'
DEPLOY_SSH_KEY_FINGERPRINT='optional, MD5 fingerprint of DEPLOY_SSH_KEY_PUB, such as 8e:0b:...; group of DEPLOY_*'
DEPLOY_SSH_KEY_PUB='optional, ssh-rsa public key of DEPLOY_SSH_KEY; group of DEPLOY_*'
DEPLOY_USER='optional, login of the deploy user on the droplet, usually deploy; group of DEPLOY_*'
DIGITAL_OCEAN_TOKEN='optional, DigitalOcean API token; required to deploy a frontend or backend droplet'
JWT_SECRET='required, random 128-character hex string for signing session tokens'
NODE_ENV='required, development or production'
OPENROUTER_TOKEN='optional, OpenRouter API key for backend agents'
RAILS_ENV='required, development or production'
SECRET_KEY_BASE='required, random 128-character hex string for Rails'
